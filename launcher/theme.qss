QWidget {
    font-family: 'Roboto', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
}

QWidget#MainWindow {
    background: #121212;
}

QDialog {
    background: #1E1E1E;
}

QLabel {
    color: #FFFFFF;
}

QPushButton {
    background: #333333;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.3px;
}

QPushButton:hover {
    background: #404040;
}

QPushButton:pressed {
    background: #4D4D4D;
}

QPushButton:disabled {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.3);
}

QLineEdit {
    background: transparent;
    color: #FFFFFF;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    padding: 9px 12px;
    font-size: 14px;
    selection-background-color: #BB86FC;
    selection-color: #000000;
}

QLineEdit:hover {
    border-color: rgba(255, 255, 255, 0.5);
}

QLineEdit:focus {
    border-color: #BB86FC;
}

QSpinBox {
    background: transparent;
    color: #FFFFFF;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    selection-background-color: #BB86FC;
    selection-color: #000000;
}

QSpinBox:hover {
    border-color: rgba(255, 255, 255, 0.5);
}

QSpinBox:focus {
    border-color: #BB86FC;
}

QCheckBox {
    spacing: 10px;
    color: #FFFFFF;
    font-size: 14px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.6);
    border-radius: 4px;
    background: transparent;
}

QCheckBox::indicator:hover {
    border-color: #BB86FC;
}

QCheckBox::indicator:checked {
    background: #BB86FC;
    border-color: #BB86FC;
}

QComboBox {
    background: transparent;
    color: #FFFFFF;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
}

QComboBox:hover {
    border-color: rgba(255, 255, 255, 0.5);
}

QComboBox:focus {
    border-color: #BB86FC;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background: #242424;
    color: #FFFFFF;
    border: 1px solid #333333;
    border-radius: 6px;
    selection-background-color: rgba(187, 134, 252, 0.2);
    selection-color: #FFFFFF;
    outline: none;
    padding: 4px;
}

QProgressBar {
    border: none;
    border-radius: 3px;
    background: rgba(187, 134, 252, 0.2);
    height: 6px;
    text-align: center;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
}

QProgressBar::chunk {
    background: #BB86FC;
    border-radius: 3px;
}

QScrollArea#MainScroll {
    border: none;
    background: transparent;
}

QScrollArea#MainScroll > QWidget {
    background: transparent;
}

QScrollArea#MainScroll > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    width: 10px;
    background: transparent;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.35);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    height: 10px;
    background: transparent;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.35);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QMenu {
    background: #242424;
    color: #FFFFFF;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: rgba(187, 134, 252, 0.2);
}

QMenu::item:disabled {
    color: rgba(255, 255, 255, 0.3);
}

QWidget#HeaderBar {
    background: #1A1A1A;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

QLabel#TitleLabel {
    font-size: 20px;
    font-weight: 600;
    color: #FFFFFF;
    letter-spacing: 0.25px;
}

QPushButton#AccountButton {
    background: transparent;
    color: #69F0AE;
    border: 1px solid rgba(105, 240, 174, 0.4);
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#AccountButton:hover {
    background: rgba(105, 240, 174, 0.1);
    border-color: rgba(105, 240, 174, 0.6);
}

QPushButton#AccountButton:pressed {
    background: rgba(105, 240, 174, 0.18);
}

QPushButton#RefreshButton {
    background: transparent;
    color: #FFD54F;
    border: 1px solid rgba(255, 213, 79, 0.4);
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#RefreshButton:hover {
    background: rgba(255, 213, 79, 0.1);
    border-color: rgba(255, 213, 79, 0.6);
}

QPushButton#RefreshButton:pressed {
    background: rgba(255, 213, 79, 0.18);
}

QPushButton#SettingsButton {
    background: transparent;
    color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#SettingsButton:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.4);
}

QPushButton#SettingsButton:pressed {
    background: rgba(255, 255, 255, 0.14);
}

QLabel#BannedLabel {
    background: rgba(207, 102, 121, 0.12);
    color: #F3B9C2;
    border: 1px solid rgba(207, 102, 121, 0.4);
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 13px;
}

QWidget#MainContent {
    background: transparent;
}

QLabel#LoadingLabel {
    color: rgba(255, 255, 255, 0.5);
    font-size: 14px;
}

QWidget#ProjectSection {
    background: transparent;
}

QWidget#ProjectSection {
    background: transparent;
}

QWidget#CardsWidget {
    background: transparent;
}

QWidget#DownloadStatus {
    background: #1A1A1A;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
}

QLabel#StatusLabel {
    color: rgba(255, 255, 255, 0.5);
    font-size: 12px;
    letter-spacing: 0.2px;
}

QPushButton#CancelButton {
    background: #CF6679;
    color: #000000;
    border: none;
    border-radius: 6px;
    padding: 8px 18px;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.5px;
}

QPushButton#CancelButton:hover {
    background: #DA7A8D;
}

QPushButton#CancelButton:pressed {
    background: #C25066;
}

QWidget#DetailsWidget {
    background: transparent;
}

QLabel#DetailKey {
    color: rgba(255, 255, 255, 0.4);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3px;
}

QLabel#DetailValue {
    color: rgba(255, 255, 255, 0.8);
    font-size: 12px;
    font-family: 'Consolas', 'Courier New', monospace;
    background: transparent;
    border: none;
}

QLabel#EmptyLabel {
    color: rgba(255, 255, 255, 0.5);
    font-size: 14px;
    padding: 32px;
}

QFrame#ModpackCard {
    background: #1E1E1E;
    border: 1px solid #2C2C2C;
    border-radius: 8px;
    padding: 4px;
}

QFrame#ModpackCard:hover {
    background: #222222;
    border-color: rgba(187, 134, 252, 0.4);
}

QLabel#ModpackIcon {
    background: #BB86FC;
    color: #000000;
    font-weight: 600;
    font-size: 16px;
    border-radius: 8px;
}

QLabel#ModpackName {
    font-weight: 600;
    font-size: 16px;
    color: #FFFFFF;
    letter-spacing: 0.15px;
}

QLabel#ModpackMeta {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.2px;
}

QLabel#ModpackDesc {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.65);
    margin-top: 4px;
    padding: 2px 0;
}

QPushButton#InstallButton {
    background: #BB86FC;
    color: #000000;
    border: none;
    border-radius: 6px;
    padding: 8px 24px;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.5px;
}

QPushButton#InstallButton:hover {
    background: #C79BFD;
}

QPushButton#InstallButton:pressed {
    background: #A875F4;
}

QPushButton#PlayButton {
    background: #69F0AE;
    color: #000000;
    border: none;
    border-radius: 6px;
    padding: 8px 24px;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.5px;
}

QPushButton#PlayButton:hover {
    background: #7FF5BC;
}

QPushButton#PlayButton:pressed {
    background: #57E69E;
}

QPushButton#PlayButton:disabled {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.3);
}

QLabel#ServerHeader {
    font-size: 11px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-top: 8px;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

QLabel#ServerLabel {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.65);
}

QWidget#ServerRow {
    background: rgba(255, 255, 255, 0.03);
    border-radius: 4px;
    padding: 2px 0;
}

QWidget#ServerRow:hover {
    background: rgba(255, 255, 255, 0.06);
}

QLabel#ServerLabel[status="online"] {
    color: #69F0AE;
}

QLabel#ServerLabel[status="starting"] {
    color: #FFD54F;
}

QLabel#ServerLabel[status="banned"] {
    color: #CF6679;
}

QLabel#ServerLabel[status="offline"] {
    color: rgba(255, 255, 255, 0.4);
}

QPushButton#ServerButton {
    background: #FFD54F;
    color: #000000;
    border: none;
    border-radius: 4px;
    padding: 5px 14px;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.3px;
}

QPushButton#ServerButton:hover {
    background: #FFDF70;
}

QPushButton#ServerButton:pressed {
    background: #F5C93F;
}

QPushButton#ServerButton:disabled {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.3);
}

QPushButton#CardMenuButton {
    background: transparent;
    color: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 14px;
}

QPushButton#CardMenuButton:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.35);
}

QPushButton#CardMenuButton:pressed {
    background: rgba(255, 255, 255, 0.14);
}

QPushButton#DeleteButton {
    background: transparent;
    color: #CF6679;
    border: 1px solid rgba(207, 102, 121, 0.6);
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.5px;
}

QPushButton#DeleteButton:hover {
    background: rgba(207, 102, 121, 0.12);
}

QPushButton#DeleteButton:pressed {
    background: rgba(207, 102, 121, 0.2);
}

QTextEdit#ConsoleOutput {
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 12px;
    background: #1A1A1A;
    color: #E0E0E0;
    border: 1px solid #2C2C2C;
    border-radius: 6px;
    padding: 8px;
}

QWidget#ConsoleWindow {
    background: #121212;
}

QPushButton#ConsoleClearButton {
    background: transparent;
    color: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.4px;
}

QPushButton#ConsoleClearButton:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.35);
}

QPushButton#ConsoleClearButton:pressed {
    background: rgba(255, 255, 255, 0.14);
}

QToolButton#ConsoleToolButton {
    background: transparent;
    color: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 500;
}

QToolButton#ConsoleToolButton:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.35);
}

QToolButton#ConsoleToolButton:pressed {
    background: rgba(255, 255, 255, 0.14);
}

QToolButton#ConsoleToolButton:checked {
    background: rgba(108, 99, 255, 0.2);
    color: #FFFFFF;
    border: 1px solid rgba(108, 99, 255, 0.5);
}

QToolButton#ConsoleNavButton {
    background: transparent;
    color: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 12px;
}

QToolButton#ConsoleNavButton:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.35);
}

QToolButton#ConsoleNavButton:pressed {
    background: rgba(255, 255, 255, 0.14);
}

QLineEdit#ConsoleSearch {
    background: #1F1F1F;
    color: #E0E0E0;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
}

QLineEdit#ConsoleSearch:focus {
    border: 1px solid #6C63FF;
}

QComboBox#ConsoleLevelFilter {
    background: #1F1F1F;
    color: #E0E0E0;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
    min-width: 140px;
}

QComboBox#ConsoleLevelFilter:hover {
    border: 1px solid #6C63FF;
}

QComboBox#ConsoleLevelFilter::drop-down {
    border: none;
    width: 22px;
}

QComboBox#ConsoleLevelFilter::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid rgba(255, 255, 255, 0.5);
    margin-right: 6px;
}

QComboBox#ConsoleLevelFilter QAbstractItemView {
    background: #1F1F1F;
    color: #E0E0E0;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    selection-background-color: rgba(108, 99, 255, 0.3);
    selection-color: #FFFFFF;
}

QCheckBox#ConsoleRegex {
    color: rgba(255, 255, 255, 0.65);
    font-size: 12px;
    spacing: 5px;
}

QLabel#ConsoleStatus {
    color: rgba(255, 255, 255, 0.4);
    font-size: 11px;
}

QLabel#DialogTitle {
    font-size: 22px;
    font-weight: 600;
    color: #FFFFFF;
    letter-spacing: 0.25px;
}

QLabel#DialogError {
    color: #CF6679;
    font-size: 13px;
    font-weight: 500;
}

QDialog QLabel {
    color: rgba(255, 255, 255, 0.65);
}

QLabel#SkinPreview {
    border: 1px dashed rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.5);
    background: #1A1A1A;
    font-size: 12px;
}

QLabel#SkinFileLabel {
    color: rgba(255, 255, 255, 0.5);
    font-size: 12px;
}

QLabel#SectionLabel {
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.3px;
    margin-top: 8px;
}

QFrame#JavaRow {
    background: #1E1E1E;
    border: 1px solid #2C2C2C;
    border-radius: 6px;
}

QLabel#JavaVersionLabel {
    color: #69F0AE;
    font-weight: 500;
    font-size: 14px;
}

QLabel#JavaPathLabel {
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
}

QPushButton#UseButton {
    background: #BB86FC;
    color: #000000;
    border: none;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.4px;
}

QPushButton#UseButton:hover {
    background: #C79BFD;
}

QPushButton#UseButton:pressed {
    background: #A875F4;
}

QPushButton#UseButton:disabled {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.3);
}

QPushButton#DeleteButton {
    background: transparent;
    color: #CF6679;
    border: 1px solid rgba(207, 102, 121, 0.4);
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.4px;
}

QPushButton#DeleteButton:hover {
    background: rgba(207, 102, 121, 0.1);
    border-color: rgba(207, 102, 121, 0.6);
}

QPushButton#DeleteButton:pressed {
    background: rgba(207, 102, 121, 0.2);
}

QPushButton#InstallJavaButton {
    background: #BB86FC;
    color: #000000;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.5px;
}

QPushButton#InstallJavaButton:hover {
    background: #C79BFD;
}

QPushButton#InstallJavaButton:pressed {
    background: #A875F4;
}
